# ============================================================================
# ENVIRONMENT VARIABLES EXAMPLE
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!
#
# Load with: source .env
# Or use with: export $(cat .env | xargs)
# ============================================================================

# ============================================================================
# MongoDB Configuration
# ============================================================================

# Option 1: Local Development
MONGODB_URI=mongodb://localhost:27017/product_catalog
MONGODB_DATABASE=product_catalog

# Option 2: MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?w=majority&journal=true&appName=ProductCatalogOMS
# MONGODB_DATABASE=product_catalog_prod

# Option 3: Self-Hosted Replica Set
# MONGODB_URI=mongodb://host1:27017,host2:27017,host3:27017/?replicaSet=rs0&w=majority&journal=true
# MONGODB_DATABASE=product_catalog_prod

# ============================================================================
# Spring Boot Configuration
# ============================================================================

# Active profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Server port
SERVER_PORT=8080

# ============================================================================
# Security Best Practices
# ============================================================================
# 1. Never commit this file with real credentials
# 2. Use different credentials per environment
# 3. Rotate credentials regularly
# 4. Use secrets management in production (AWS Secrets Manager, Vault, etc.)
# 5. Set minimum required permissions for database user
# ============================================================================
